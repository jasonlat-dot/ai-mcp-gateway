<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jasonlat.ai.infrastructure.dao.IMcpGatewayAuthDao">

    <resultMap id="McpGatewayAuthMap" type="com.jasonlat.ai.infrastructure.dao.po.McpGatewayAuthPO">
        <id column="id" property="id"/>
        <result column="gateway_id" property="gatewayId"/>
        <result column="api_key" property="apiKey"/>
        <result column="rate_limit" property="rateLimit"/>
        <result column="expire_time" property="expireTime"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, gateway_id, api_key, rate_limit, expire_time, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayAuthPO" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO mcp_gateway_auth
        <trim prefix="(" suffix=")" suffixOverrides=",">
            gateway_id,
            <if test="apiKey != null and apiKey.trim().length() > 0">api_key,</if>
            <if test="rateLimit != null">rate_limit,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{gatewayId},
            <if test="apiKey != null and apiKey.trim().length() > 0">#{apiKey},</if>
            <if test="rateLimit != null">#{rateLimit},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM mcp_gateway_auth
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

    <update id="updateById" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayAuthPO">
        UPDATE mcp_gateway_auth
        <set>
            <if test="gatewayId != null and gatewayId.trim().length() > 0">gateway_id = #{gatewayId},</if>
            <if test="apiKey != null and apiKey.trim().length() > 0">api_key = #{apiKey},</if>
            <if test="rateLimit != null">rate_limit = #{rateLimit},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="status != null">status = #{status},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="(gatewayId == null or gatewayId.trim().length() == 0)
                      and (apiKey == null or apiKey.trim().length() == 0)
                      and rateLimit == null
                      and expireTime == null
                      and status == null">
                AND 1 = 0
            </if>
        </where>
    </update>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpGatewayAuthMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_auth
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="queryAll" resultMap="McpGatewayAuthMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_auth
        ORDER BY id DESC
    </select>
    <select id="queryMcpGatewayAuthPO" resultType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayAuthPO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_auth
        WHERE gateway_id = #{gatewayId} and api_key = #{apiKey}
    </select>

</mapper>
