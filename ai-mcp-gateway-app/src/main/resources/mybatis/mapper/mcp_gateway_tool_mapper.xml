<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jasonlat.ai.infrastructure.dao.IMcpGatewayToolDao">

    <resultMap id="McpGatewayToolMap" type="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO">
        <id column="id" property="id"/>
        <result column="gateway_id" property="gatewayId"/>
        <result column="tool_id" property="toolId"/>
        <result column="tool_name" property="toolName"/>
        <result column="tool_type" property="toolType"/>
        <result column="tool_description" property="toolDescription"/>
        <result column="tool_version" property="toolVersion"/>
        <result column="protocol_id" property="protocolId"/>
        <result column="protocol_type" property="protocolType"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, gateway_id, tool_id, tool_name, tool_type, tool_description, tool_version, protocol_id, protocol_type, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO mcp_gateway_tool
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            gateway_id,
            tool_id,
            tool_name,
            <if test="toolType != null and toolType.trim().length() > 0">tool_type,</if>
            <if test="toolDescription != null and toolDescription.trim().length() > 0">tool_description,</if>
            <if test="toolVersion != null and toolVersion.trim().length() > 0">tool_version,</if>
            <if test="protocolId != null">protocol_id,</if>
            <if test="protocolType != null and protocolType.trim().length() > 0">protocol_type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            #{gatewayId},
            #{toolId},
            #{toolName},
            <if test="toolType != null and toolType.trim().length() > 0">#{toolType},</if>
            <if test="toolDescription != null and toolDescription.trim().length() > 0">#{toolDescription},</if>
            <if test="toolVersion != null and toolVersion.trim().length() > 0">#{toolVersion},</if>
            <if test="protocolId != null">#{protocolId},</if>
            <if test="protocolType != null and protocolType.trim().length() > 0">#{protocolType},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM mcp_gateway_tool
        <choose>
            <when test="_parameter != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

    <update id="updateById" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO">
        UPDATE mcp_gateway_tool
        <set>
            <if test="gatewayId != null and gatewayId.trim().length() > 0">gateway_id = #{gatewayId},</if>
            <if test="toolId != null">tool_id = #{toolId},</if>
            <if test="toolName != null and toolName.trim().length() > 0">tool_name = #{toolName},</if>
            <if test="toolType != null and toolType.trim().length() > 0">tool_type = #{toolType},</if>
            <if test="toolDescription != null and toolDescription.trim().length() > 0">tool_description = #{toolDescription},</if>
            <if test="toolVersion != null and toolVersion.trim().length() > 0">tool_version = #{toolVersion},</if>
            <if test="protocolId != null">protocol_id = #{protocolId},</if>
            <if test="protocolType != null and protocolType.trim().length() > 0">protocol_type = #{protocolType},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="(gatewayId == null or gatewayId.trim().length() == 0)
                      and (toolId == null)
                      and (toolName == null or toolName.trim().length() == 0)
                      and (toolType == null or toolType.trim().length() == 0)
                      and (toolDescription == null or toolDescription.trim().length() == 0)
                      and (toolVersion == null or toolVersion.trim().length() == 0)
                      and protocolId == null
                      and (protocolType == null or protocolType.trim().length() == 0)">
                AND 1 = 0
            </if>
        </where>
    </update>

    <update id="updateProtocolByGatewayId">
        UPDATE mcp_gateway_tool
        <set>
            <!-- 仅当参数非空、非空串才更新，避免覆盖原有数据 -->
            <if test="protocolId != null">
                protocol_id = #{protocolId},
            </if>
            <if test="protocolType != null and protocolType.trim() != ''">
                protocol_type = #{protocolType},
            </if>
            <!-- PG标准时间函数，兼容MySQL/PostgreSQL，统一由数据库生成更新时间 -->
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE gateway_id = #{gatewayId}
    </update>

    <update id="updateToolConfigByToolId" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO">
        UPDATE mcp_gateway_tool
        <set>
            <if test="gatewayId != null and gatewayId.trim() != ''">gateway_id = #{gatewayId},</if>
            <if test="toolName != null and toolName.trim() != ''">tool_name = #{toolName},</if>
            <if test="toolType != null and toolType.trim() != ''">tool_type = #{toolType},</if>
            <if test="toolDescription != null and toolDescription.trim() != ''">tool_description = #{toolDescription},</if>
            <if test="toolVersion != null and toolVersion.trim() != ''">tool_version = #{toolVersion},</if>
            <if test="protocolId != null">protocol_id = #{protocolId},</if>
            <if test="protocolType != null and protocolType.trim() != ''">protocol_type = #{protocolType},</if>
            update_time = #{updateTime}
        </set>
        <where>
            <choose>
                <when test="toolId != null">
                    tool_id = #{toolId}
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
        </where>
    </update>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpGatewayToolMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_tool
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="queryAll" resultMap="McpGatewayToolMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_tool
        ORDER BY id DESC
    </select>

    <select id="queryEffectiveTools" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO"
            resultMap="McpGatewayToolMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_tool
        <choose>
            <when test="gatewayId != null and gatewayId.trim().length() > 0">
                WHERE gateway_id = #{gatewayId}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="queryToolProtocolIdByToolName" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO" resultType="java.lang.Long">
        SELECT protocol_id FROM mcp_gateway_tool
        <where>
            <if test="gatewayId != null and gatewayId.trim().length() > 0">
                AND gateway_id = #{gatewayId}
            </if>
            <if test="toolName != null and toolName.trim().length() > 0">
                AND tool_name = #{toolName}
            </if>
        </where>
    </select>

    <!-- 多协议路由用:取完整 tool PO,带 protocol_type -->
    <select id="queryByGatewayIdAndToolName" resultMap="McpGatewayToolMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_gateway_tool
        <where>
            gateway_id = #{gatewayId}
            AND tool_name = #{toolName}
        </where>
        LIMIT 1
    </select>

    <select id="queryListByGatewayId" parameterType="java.lang.String" resultMap="McpGatewayToolMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM mcp_gateway_tool
        WHERE gateway_id = #{gatewayId}
    </select>

    <select id="queryToolList" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO" resultMap="McpGatewayToolMap">
        SELECT id, gateway_id, tool_id, tool_name, tool_type, tool_description, tool_version, protocol_id, protocol_type,
        create_time, update_time
        FROM mcp_gateway_tool
        <where>
            <if test="gatewayId != null and gatewayId != ''">
                AND gateway_id like concat('%', #{gatewayId}, '%')
            </if>
            <if test="toolId != null and toolId != ''">
                AND tool_id like concat('%', #{toolId}, '%')
            </if>
            <if test="toolName != null and toolName != ''">
                AND tool_name like concat('%', #{toolName}, '%')
            </if>
        </where>
        ORDER BY update_time DESC
        <if test="limitStart != null and limitCount != null">
            LIMIT #{limitCount} OFFSET #{limitStart}
        </if>
    </select>

    <select id="queryToolListCount" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpGatewayToolPO" resultType="java.lang.Long">
        SELECT count(id)
        FROM mcp_gateway_tool
        <where>
            <if test="gatewayId != null and gatewayId != ''">
                AND gateway_id like concat('%', #{gatewayId}, '%')
            </if>
            <if test="toolId != null and toolId != ''">
                AND tool_id like concat('%', #{toolId}, '%')
            </if>
            <if test="toolName != null and toolName != ''">
                AND tool_name like concat('%', #{toolName}, '%')
            </if>
        </where>
    </select>

    <delete id="deleteByToolId" parameterType="java.lang.Long">
        DELETE FROM mcp_gateway_tool WHERE tool_id = #{toolId}
    </delete>

    <!-- 删除网关前引用校验专用:精确等值统计某网关下的工具数量 -->
    <select id="countByGatewayId" parameterType="java.lang.String" resultType="java.lang.Long">
        SELECT count(id)
        FROM mcp_gateway_tool
        WHERE gateway_id = #{gatewayId}
    </select>

</mapper>

