    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List" useGeneratedKeys="false">
        INSERT INTO mcp_protocol_dubbo (
        protocol_id,
        interface_name,
        group_name,
        version,
        method_name,
        parameter_types,
        timeout,
        retry_times,
        direct_url,
        direct_enabled,
        status
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.protocolId},
            #{item.interfaceName},
            #{item.groupName},
            #{item.version},
            #{item.methodName},
            #{item.parameterTypes},
            #{item.timeout},
            #{item.retryTimes},
            #{item.directUrl},
            #{item.directEnabled ? 1 : 0},
            #{item.status}
