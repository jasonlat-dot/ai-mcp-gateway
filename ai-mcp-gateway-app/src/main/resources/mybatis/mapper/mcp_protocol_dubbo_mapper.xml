            <if test="interfaceName != null and interfaceName.trim().length() > 0">interface_name = #{interfaceName},</if>
            <if test="groupName != null and groupName.trim().length() > 0">group_name = #{groupName},</if>
            <if test="version != null and version.trim().length() > 0">version = #{version},</if>
            <if test="methodName != null and methodName.trim().length() > 0">method_name = #{methodName},</if>
            <if test="parameterTypes != null and parameterTypes.trim().length() > 0">parameter_types = #{parameterTypes},</if>
            <if test="timeout != null">timeout = #{timeout},</if>
            <if test="retryTimes != null">retry_times = #{retryTimes},</if>
            <if test="directUrl != null and directUrl.trim().length() > 0">direct_url = #{directUrl},</if>
            <if test="directEnabled != null">direct_enabled = #{directEnabled ? 1 : 0},</if>
            <if test="status != null">status = #{status},</if>
