        <foreach collection="list" item="protocolId" open="(" separator="," close=")">
            #{protocolId}
        </foreach>
    </select>

    <select id="queryProtocolList" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpProtocolDubboPO" resultMap="McpProtocolDubboMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_dubbo
        <where>
            <if test="protocolId != null">
                AND protocol_id = #{protocolId}
            </if>
            <if test="interfaceName != null and interfaceName.trim().length() != 0">
                AND interface_name like concat('%', #{interfaceName}, '%')
            </if>
            <if test="methodName != null and methodName.trim().length() != 0">
                AND method_name like concat('%', #{methodName}, '%')
            </if>
        </where>
        ORDER BY update_time DESC
        <if test="limitStart != null and limitCount != null">
            LIMIT #{limitCount} OFFSET #{limitStart}
        </if>
    </select>

