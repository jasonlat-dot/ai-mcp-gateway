<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jasonlat.ai.infrastructure.dao.IMcpProtocolHttpDao">

    <resultMap id="McpProtocolRegistryMap" type="com.jasonlat.ai.infrastructure.dao.po.McpProtocolHttpPO">
        <id column="id" property="id"/>
        <result column="protocol_id" property="protocolId"/>
        <result column="http_url" property="httpUrl"/>
        <result column="http_method" property="httpMethod"/>
        <result column="http_headers" property="httpHeaders"/>
        <result column="timeout" property="timeout"/>
        <result column="retry_times" property="retryTimes"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, protocol_id, http_url, http_method, http_headers, timeout, retry_times, status, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpProtocolHttpPO" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO mcp_protocol_http
        <trim prefix="(" suffix=")" suffixOverrides=",">
            protocol_id,
            http_url,
            <if test="httpMethod != null and httpMethod.trim().length() > 0">http_method,</if>
            <if test="httpHeaders != null and httpHeaders.trim().length() > 0">http_headers,</if>
            <if test="timeout != null">timeout,</if>
            <if test="retryTimes != null">retry_times,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{protocolId},
            #{httpUrl},
            <if test="httpMethod != null and httpMethod.trim().length() > 0">#{httpMethod},</if>
            <if test="httpHeaders != null and httpHeaders.trim().length() > 0">#{httpHeaders},</if>
            <if test="timeout != null">#{timeout},</if>
            <if test="retryTimes != null">#{retryTimes},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM mcp_protocol_http
        <choose>
            <when test="_parameter != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

    <update id="updateById" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpProtocolHttpPO">
        UPDATE mcp_protocol_http
        <set>
            <if test="protocolId != null">protocol_id = #{protocolId},</if>
            <if test="httpUrl != null and httpUrl.trim().length() > 0">http_url = #{httpUrl},</if>
            <if test="httpMethod != null and httpMethod.trim().length() > 0">http_method = #{httpMethod},</if>
            <if test="httpHeaders != null and httpHeaders.trim().length() > 0">http_headers = #{httpHeaders},</if>
            <if test="timeout != null">timeout = #{timeout},</if>
            <if test="retryTimes != null">retry_times = #{retryTimes},</if>
            <if test="status != null">status = #{status},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="(protocolId == null)
                      and (httpUrl == null or httpUrl.trim().length() == 0)
                      and (httpMethod == null or httpMethod.trim().length() == 0)
                      and (httpHeaders == null or httpHeaders.trim().length() == 0)
                      and timeout == null
                      and retryTimes == null
                      and status == null">
                AND 1 = 0
            </if>
        </where>
    </update>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpProtocolRegistryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_http
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="queryAll" resultMap="McpProtocolRegistryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_http
        ORDER BY id DESC
    </select>

    <select id="queryMcpProtocolHttpByProtocolId" parameterType="java.lang.Long" resultMap="McpProtocolRegistryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_http
        <choose>
            <when test="protocolId != null">
                WHERE protocol_id = #{protocolId}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List" useGeneratedKeys="false">
        INSERT INTO mcp_protocol_http (
        protocol_id,
        http_url,
        http_method,
        http_headers,
        timeout,
        retry_times,
        status
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.protocolId},
            #{item.httpUrl},
            #{item.httpMethod},
            #{item.httpHeaders},
            #{item.timeout},
            #{item.retryTimes},
            #{item.status}
            )
        </foreach>
    </insert>

</mapper>

