    <insert id="insert" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpProtocolRegistryPO" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO mcp_protocol_registry
        <trim prefix="(" suffix=")" suffixOverrides=",">
            gateway_id,
            tool_id,
            tool_name,
            <if test="toolType != null and toolType.trim().length() > 0">tool_type,</if>
            <if test="toolDescription != null and toolDescription.trim().length() > 0">tool_description,</if>
            http_url,
