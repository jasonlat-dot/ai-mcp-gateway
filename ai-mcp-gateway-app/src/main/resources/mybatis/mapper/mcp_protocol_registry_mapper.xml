        </trim>
    </insert>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM mcp_protocol_registry
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </delete>

    <update id="updateById" parameterType="com.jasonlat.ai.infrastructure.dao.po.McpProtocolRegistryPO">
        UPDATE mcp_protocol_registry
        <set>
            <if test="gatewayId != null and gatewayId.trim().length() > 0">gateway_id = #{gatewayId},</if>
            <if test="toolId != null">tool_id = #{toolId},</if>
            <if test="toolName != null and toolName.trim().length() > 0">tool_name = #{toolName},</if>
            <if test="toolType != null and toolType.trim().length() > 0">tool_type = #{toolType},</if>
            <if test="toolDescription != null and toolDescription.trim().length() > 0">tool_description = #{toolDescription},</if>
            <if test="httpUrl != null and httpUrl.trim().length() > 0">http_url = #{httpUrl},</if>
            <if test="httpMethod != null and httpMethod.trim().length() > 0">http_method = #{httpMethod},</if>
            <if test="httpHeaders != null and httpHeaders.trim().length() > 0">http_headers = #{httpHeaders},</if>
            <if test="timeout != null">timeout = #{timeout},</if>
            <if test="retryTimes != null">retry_times = #{retryTimes},</if>
            <if test="status != null">status = #{status},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        <where>
            <choose>
                <when test="id != null">
                    id = #{id}
                </when>
                <otherwise>
                    1 = 0
                </otherwise>
            </choose>
            <if test="(gatewayId == null or gatewayId.trim().length() == 0)
                      and toolId == null
                      and (toolName == null or toolName.trim().length() == 0)
                      and (toolType == null or toolType.trim().length() == 0)
                      and (toolDescription == null or toolDescription.trim().length() == 0)
                      and (httpUrl == null or httpUrl.trim().length() == 0)
                      and (httpMethod == null or httpMethod.trim().length() == 0)
                      and (httpHeaders == null or httpHeaders.trim().length() == 0)
                      and timeout == null
                      and retryTimes == null
                      and status == null">
                AND 1 = 0
            </if>
        </where>
    </update>

    <select id="queryById" parameterType="java.lang.Long" resultMap="McpProtocolRegistryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_registry
        <choose>
            <when test="id != null">
                WHERE id = #{id}
            </when>
            <otherwise>
                WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <select id="queryAll" resultMap="McpProtocolRegistryMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM mcp_protocol_registry
        ORDER BY id DESC
    </select>

</mapper>
